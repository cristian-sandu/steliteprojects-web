{
  "name": "st-elite-projects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run check:seo",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --import tsx --test tests/*.test.ts tests/runtime/*.test.ts",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "miniflare": "5.20260926.1-alpha",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.143.1"
  }
}
