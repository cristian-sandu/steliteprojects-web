---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import { company, languages, href, type Lang, type Page } from '../data/company';
import { activeServices } from '../data/services';
import copy from '../data/copy.json';
interface Props {lang:Lang; page:Page; title:string}
const {lang,page,title}=Astro.props;
const d=copy[lang];
const navPages=['','services','about','projects','contact'];
const indexable=import.meta.env.PUBLIC_INDEXABLE === 'true';
const absolute=(l:Lang)=>new URL(href(l,page),Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head><meta charset="utf-8"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | {company.name}</title><meta name="description" content={d.intro}/><meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/><link rel="canonical" href={absolute(lang)}/>{languages.map(l=><link rel="alternate" hreflang={l} href={absolute(l)}/>)}<link rel="alternate" hreflang="x-default" href={absolute('fr')}/><meta property="og:title" content={`${title} | ${company.name}`}/><meta property="og:description" content={d.intro}/><meta property="og:type" content="website"/><meta property="og:url" content={absolute(lang)}/></head>
<body>
<a href="#main" class="skip-link">{lang==='fr'?'Aller au contenu':'Skip to content'}</a>
<div class="top"><div class="wrap"><span>MONTREUIL · PARIS · ÎLE-DE-FRANCE</span><span>{d.audience}</span></div></div>
<header><div class="wrap header"><a class:list={["logo", {"brand-image": Boolean(company.logo)}]} href={href(lang)} aria-label={company.name}>{company.logo?<Brand/>:<Fragment>ST <b>ÉLITE</b><small>PROJECTS</small></Fragment>}</a><nav aria-label={lang==='fr'?'Navigation principale':'Main navigation'}>{navPages.map((p,i)=><a href={href(lang,p)} aria-current={p===page?'page':undefined}>{d.nav[i]}</a>)}</nav><div class="tools"><div class="lang">{languages.map(l=><a href={href(l,page)} lang={l} class:list={{active:l===lang}} aria-label={l==='fr'?'Français':'English'}>{l.toUpperCase()}</a>)}</div><a class="header-phone" href={`tel:${company.phoneHref}`} aria-label={`${d.call} — ${company.phone}`}>{company.phone}</a><a class="button" href={href(lang,'contact')}>{d.quote}</a><button class="menu" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">☰</button></div></div><div class="mobile-nav" id="mobile-nav">{navPages.map((p,i)=><a href={href(lang,p)} aria-current={p===page?'page':undefined}>{d.nav[i]}</a>)}</div></header>
<main id="main"><slot/>{page!=='contact'&&<section class="cta-band"><div class="wrap"><h2>{d.cta}</h2><a class="button" href={href(lang,'contact')}>{d.quote}</a></div></section>}</main>
<footer><div class="wrap"><div class="footer-grid"><div><a class:list={["logo", {"brand-image": Boolean(company.logo)}]} href={href(lang)} aria-label={company.name}>{company.logo?<Brand/>:<Fragment>ST <b>ÉLITE</b><small>PROJECTS</small></Fragment>}</a><p>{d.region}<br/>{activeServices.map(s=>s[lang].name).join(' · ')}</p></div><div class="links"><h3>Navigation</h3>{navPages.map((p,i)=><a href={href(lang,p)}>{d.nav[i]}</a>)}</div><div><h3>Contact</h3><a href={`tel:${company.phoneHref}`}>{company.phone}</a><br/><a href={`mailto:${company.email}`}>{company.email}</a><p>{company.address}<br/>{company.city}</p></div></div><div class="fine"><span>© {new Date().getFullYear()} {company.name}</span><span><a href={href(lang,'legal')}>{d.legal}</a> · <a href={href(lang,'privacy')}>{d.privacy}</a></span></div></div></footer>
<div class="mobile-bar"><a href={`tel:${company.phoneHref}`}>{d.call}</a><a href={href(lang,'contact')}>{d.quote}</a></div>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu');
menu?.addEventListener('click',()=>{const open=document.getElementById('mobile-nav')?.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));});
const mobileBar=document.querySelector<HTMLElement>('.mobile-bar');
if(mobileBar){
 const updateBarSpace=()=>document.documentElement.style.setProperty('--mobile-bar-space',`${mobileBar.getBoundingClientRect().height+16}px`);
 new ResizeObserver(updateBarSpace).observe(mobileBar);updateBarSpace();
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('mobile-nav')?.classList.contains('open')){document.getElementById('mobile-nav')?.classList.remove('open');menu?.setAttribute('aria-expanded','false');menu?.focus();}});
</script>
</body></html>
