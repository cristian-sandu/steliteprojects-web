---
import Layout from '../../layouts/Layout.astro';
import Services from '../../components/Services.astro';
import Method from '../../components/Method.astro';
import Contact from '../../components/Contact.astro';
import {company,languages,pages,href,type Lang,type Page} from '../../data/company';
import {activeServices} from '../../data/services';
import {projects} from '../../data/projects';
import copy from '../../data/copy.json';
export function getStaticPaths(){return languages.flatMap(lang=>pages.map(page=>({params:{lang,page:page||undefined},props:{lang,page}})));}
const {lang,page}=Astro.props as {lang:Lang;page:Page};const d=copy[lang];
const title=page==='legal'?d.legal:page==='privacy'?d.privacy:d.nav[pages.indexOf(page)];
const heading={services:d.serviceshead,projects:d.projecttitle,about:d.abouttitle,contact:d.contacttitle,legal:d.legal,privacy:d.privacy,'':d.headline}[page];
const intro={services:d.intro,projects:d.projectintro,about:d.aboutintro,contact:d.contactintro,legal:'',privacy:'','':d.intro}[page];
const visibleProjects=projects.filter(p=>activeServices.some(s=>s.id===p.service));
const missing=lang==='fr'?'À compléter avant lancement':'Complete before launch';
---
<Layout lang={lang} page={page} title={title}>
{page===''?<Fragment><section class="hero"><div class="wrap hero-grid"><div class="reveal"><div class="eyebrow">{d.tag}</div><h1 set:html={d.headline}/><p>{activeServices.map(s=>s[lang].name).join(' · ')}<br/>{d.intro}</p><div class="actions"><a class="button" href={href(lang,'contact')}>{d.quote}</a><a class="textlink" href={`tel:${company.phoneHref}`}>{d.call}</a></div></div>{company.heroImage?<img class="hero-photo" src={company.heroImage} alt={lang==='fr'?'Un chantier de ST ÉLITE PROJECTS':'A ST ÉLITE PROJECTS worksite'} width="700" height="850" fetchpriority="high"/>:company.logo?<div class="hero-brand reveal"><img src={company.logo} alt={company.name} width="1448" height="1086" fetchpriority="high"/></div>:<div class="signature reveal"><div class="caption">ST ÉLITE PROJECTS / MONTREUIL</div><div class="word">ST<span>ÉLITE.</span></div><div class="sig-foot">{activeServices.map(s=><Fragment>{s[lang].name}<br/></Fragment>)}Île-de-France</div></div>}</div></section><div class="trust"><div class="wrap">{d.trust.map(item=><span>{item}</span>)}</div></div><section class="section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">{d.expert}</div><h2 set:html={d.serviceshead}/></div><a class="textlink" href={href(lang,'services')}>{d.nav[1]}</a></div><Services lang={lang}/></div></section><Method lang={lang}/></Fragment>:<section class="page-title"><div class="wrap reveal"><div class="eyebrow">{company.name}</div><h1 set:html={heading}/><p>{intro}</p></div></section>}
{page==='services'&&<section class="section"><div class="wrap"><Services lang={lang}/></div></section>}
{page==='about'&&<Fragment><section class="section"><div class="wrap"><div class="eyebrow">{lang==='fr'?'Notre entreprise':'Our company'}</div><h2>{lang==='fr'?'Implantée à Montreuil.':'Based in Montreuil.'}</h2><p class="body-copy">{lang==='fr'?`Présidée par ${company.president}, ST ÉLITE PROJECTS a été immatriculée au RCS de Bobigny le ${company.registrationDate}. Son activité a débuté le ${company.activityStartDate}.`:`Led by company president ${company.president}, ST ÉLITE PROJECTS was registered with the Bobigny trade register on 22 September 2026. Business activities began on 13 September 2026.`}</p></div></section><Method lang={lang}/></Fragment>}
{page==='contact'&&<Contact lang={lang}/>}
{page==='projects'&&<section class="section"><div class="wrap">{visibleProjects.length?visibleProjects.map(project=><article class="project"><div class="eyebrow">{project.city}</div><h2>{project.title[lang]}</h2><p class="body-copy">{project.description[lang]}</p><div class="project-gallery">{project.images.map(image=><a href={image.src} target="_blank" rel="noopener"><img src={image.src} alt={image.alt[lang]} width="800" height="600" loading="lazy"/></a>)}</div></article>):<div class="project-empty"><span class="number">ST ÉLITE PROJECTS</span><h3>{d.projectempty}</h3><p class="body-copy">{d.projectnote}</p><a class="button" href={href(lang,'contact')}>{d.quote}</a></div>}</div></section>}
{page==='legal'&&<section class="section"><div class="wrap legal"><p>{lang==='fr'?'Version de travail : informations à confirmer et compléter avant lancement.':'Draft: confirm and complete these details before launch.'}</p><h2>{company.name}</h2><p>SAS · Capital : {company.capital}<br/>{company.address}, {company.city}<br/>SIREN : {company.siren}<br/>RCS : {company.rcs}<br/>EUID : {company.euid}<br/>{lang==='fr'?'Date d’immatriculation':'Registration date'} : {company.registrationDate}<br/>{lang==='fr'?'Début d’activité':'Business start date'} : {company.activityStartDate}<br/>{lang==='fr'?'Président':'President'} : {company.president}</p><p>SIRET : {company.siret||missing}<br/>TVA : {company.vat||missing}</p><p>{lang==='fr'?'Directeur de la publication':'Publication director'} : {company.director}<br/>{company.phone} · {company.email}</p><p>{lang==='fr'?'Hébergeur':'Hosting provider'} : {company.host||missing}<br/>{lang==='fr'?'Médiateur':'Consumer mediator'} : {company.mediator||missing}</p></div></section>}
{page==='privacy'&&<section class="section"><div class="wrap legal"><h2>{lang==='fr'?'Politique à finaliser avant lancement':'Policy to finalise before launch'}</h2><p>{lang==='fr'?'Le formulaire recueille votre nom, votre téléphone, votre e-mail facultatif, votre localité, la nature des travaux, votre description et les photos facultatives. Ces données permettent de répondre à votre demande et de préparer un devis.':'The form collects your name, phone number, optional email, location, type of work, description and optional photographs to respond to your enquiry and prepare a quote.'}</p><p>{lang==='fr'?'Les demandes sont transmises par e-mail à ST ÉLITE PROJECTS. La configuration prévue utilise Cloudflare pour l’hébergement et la protection anti-spam, et Resend pour la transmission des e-mails. Les photos sont jointes à la demande ; elles ne sont pas publiées sur le site.':'Requests are emailed to ST ÉLITE PROJECTS. The planned setup uses Cloudflare for hosting and spam protection and Resend for email delivery. Photographs are attached to the enquiry and are not published on the website.'}</p><p>{lang==='fr'?'Pour demander l’accès à vos données, leur rectification ou leur suppression, contactez :':'To request access, correction or deletion of your data, contact:'} <a href={`mailto:${company.email}`}>{company.email}</a>.</p><p>{lang==='fr'?'À compléter avec l’entreprise avant activation : base légale, durée de conservation, destinataires, transferts éventuels et voies de réclamation. Aucun outil publicitaire ou de mesure d’audience n’est inclus.':'Complete with the company before activation: legal basis, retention period, recipients, any international transfers and complaint routes. No advertising or analytics tools are included.'}</p></div></section>}
</Layout>
