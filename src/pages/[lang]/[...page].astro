---
import SitePage from '../../components/SitePage.astro';
import {languages,pages,type Lang,type Page} from '../../data/company';
export function getStaticPaths(){return languages.flatMap(lang=>pages.map(page=>({params:{lang,page:page||undefined},props:{lang,page}})));}
const {lang,page}=Astro.props as {lang:Lang;page:Page};
---
<SitePage lang={lang} page={page}/>
