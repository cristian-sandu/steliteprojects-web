{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steliteprojects-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "QUOTES_ENABLED": "true",
    "CONTACT_TO": "cristian.sandu.connect@gmail.com",
    "MAIL_FROM": "devis@forms.steliteprojects.com",
    "TURNSTILE_HOSTNAME": "steliteprojects-web.cristian-sandu-connect.workers.dev"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "cristian.sandu.connect@gmail.com",
      "allowed_sender_addresses": [
        "devis@forms.steliteprojects.com"
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTE_LIMITS",
        "class_name": "QuoteLimits"
      }
    ]
  },
  "migrations": [
    {
      "tag": "quote-limits-v1",
      "new_sqlite_classes": [
        "QuoteLimits"
      ]
    }
  ]
}
